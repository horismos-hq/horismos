# A pre-extracted SNOMED CT subset for the triage example (decision D5,
# PRP-001): ~50 chest-pain-centered concepts, consumed as an ordinary import
# into a named graph. Its hierarchy connects to triage.ttl's owl:sameAs
# anchors (sct:29857009 = :ChestPain), so sameAs-bridged subsumption over
# imported concepts is real, not decorative. Concept IDs follow SNOMED CT
# where known; the fixture's point is the structure, not registry fidelity.
# Extraction tooling that produces files like this one belongs to PRP-007.

@prefix sct:  <http://snomed.info/id/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

## Root

sct:404684003 a rdfs:Class ;
    rdfs:label "Clinical finding" .

## Cardiovascular findings

sct:106063007 a rdfs:Class ;
    rdfs:subClassOf sct:404684003 ;
    rdfs:label      "Cardiovascular finding" .

sct:29857009 a rdfs:Class ;
    rdfs:subClassOf sct:106063007 ;
    rdfs:label      "Chest pain" .          # anchored: triage:ChestPain owl:sameAs

sct:71884009 a rdfs:Class ;
    rdfs:subClassOf sct:29857009 ;
    rdfs:label      "Crushing chest pain" .

sct:2237002 a rdfs:Class ;
    rdfs:subClassOf sct:29857009 ;
    rdfs:label      "Pleuritic chest pain" .

