    rdfs:label      "Unstable angina" .

sct:233819005 a rdfs:Class ;
    rdfs:subClassOf sct:194828000 ;
    rdfs:label      "Stable angina" .

sct:80313002 a rdfs:Class ;
    rdfs:subClassOf sct:106063007 ;
    rdfs:label      "Palpitations" .

sct:3424008 a rdfs:Class ;
    rdfs:subClassOf sct:106063007 ;
    rdfs:label      "Tachycardia" .

sct:11092001 a rdfs:Class ;
    rdfs:subClassOf sct:3424008 ;
    rdfs:label      "Sinus tachycardia" .

sct:25569003 a rdfs:Class ;
    rdfs:subClassOf sct:3424008 ;
    rdfs:label      "Ventricular tachycardia" .

sct:48867003 a rdfs:Class ;
    rdfs:subClassOf sct:106063007 ;
    rdfs:label      "Bradycardia" .

sct:45007003 a rdfs:Class ;
    rdfs:subClassOf sct:106063007 ;
    rdfs:label      "Hypotension" .

sct:38341003 a rdfs:Class ;
    rdfs:subClassOf sct:106063007 ;
    rdfs:label      "Hypertension" .

sct:22298006 a rdfs:Class ;
    rdfs:subClassOf sct:106063007 ;
    rdfs:label      "Myocardial infarction" .

sct:57054005 a rdfs:Class ;
    rdfs:subClassOf sct:22298006 ;
    rdfs:label      "Acute myocardial infarction" .

sct:410429000 a rdfs:Class ;
    rdfs:subClassOf sct:106063007 ;
    rdfs:label      "Cardiac arrest" .

sct:308546005 a rdfs:Class ;
    rdfs:subClassOf sct:106063007 ;
    rdfs:label      "Dissection of aorta" .

