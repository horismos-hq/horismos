"""Type stubs for the native module (kept in the same change as the surface)."""

from os import PathLike
from typing import Any, final

__version__: str
PROFILE_VERSION: str

class HorismosError(Exception):
    domain_text: str
    suggestion: str | None

class HorismosOntologyError(HorismosError): ...
class HorismosVerificationError(HorismosError): ...

class HorismosValidationError(HorismosError):
    constraint: str
    data: dict[str, Any]
    subject: str
    class_: str
    property: str | None
    value: str | None
    provenance: str
    operation: str

class HorismosWorkflowError(HorismosError): ...
class HorismosBridgeError(HorismosError): ...
class HorismosToolError(HorismosError): ...

@final
class Ref:
    @property
    def iri(self) -> str: ...
    @property
    def curie(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Rule:
    @property
    def iri(self) -> str: ...
    @property
    def curie(self) -> str: ...
    @property
    def priority(self) -> int: ...
    @property
    def explain(self) -> str | None: ...

@final
class Ontology:
    @staticmethod
    def load(path: str | PathLike[str], imports: list[str | PathLike[str]] = ...) -> Ontology: ...
    def namespaces(self) -> dict[str, str]: ...
    def expand(self, term: str) -> str: ...
    def compact(self, iri: str) -> str: ...
    def ref(self, term: str) -> Ref: ...
    def rules(self) -> list[Rule]: ...
    def property_table(self) -> list[tuple[str, str, bool, str | None]]: ...
    def class_table(self) -> list[tuple[str, str, list[str] | None]]: ...

@final
class ProofNode:
    @property
    def rule(self) -> str | None: ...
    def render(self) -> str: ...

@final
class Fact:
    kind: str
    subject: str
    property: str | None
    value: Any

@final
class Diff:
    @property
    def added(self) -> list[Fact]: ...
    @property
    def removed(self) -> list[Fact]: ...

@final
class Snapshot:
    def to_bytes(self) -> bytes: ...
    @staticmethod
    def from_bytes(onto: Ontology, data: bytes) -> Snapshot: ...

@final
class World:
    def __init__(self, onto: Ontology) -> None: ...
    def assert_(
        self,
        class_term: str,
        properties: list[tuple[str, Any]],
        subject: str | None = None,
    ) -> Ref: ...
    def retract(self, subject: Ref, property_term: str, value: Any) -> None: ...
    def instances(self, class_term: str) -> list[Ref]: ...
    def query(self, class_term: str, patterns: list[tuple[str, Any]]) -> list[Ref]: ...
    def value(self, subject: Ref, property_term: str) -> Any | None: ...
    def values(self, subject: Ref, property_term: str) -> list[Any]: ...
    def explain(self, subject: Ref, property_term: str) -> ProofNode | None: ...
    def prove(self, subject: Ref, property_term: str, value: Any) -> ProofNode | None: ...
    def snapshot(self) -> Snapshot: ...
    @staticmethod
    def from_snapshot(onto: Ontology, snapshot: Snapshot) -> World: ...
    def diff(self, snapshot: Snapshot) -> Diff: ...
